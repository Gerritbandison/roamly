# ── Required ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...           # Claude API key (https://console.anthropic.com)

# Clerk Auth (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Database — Neon Postgres (add via Vercel Marketplace or https://neon.tech)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── Optional (features degrade gracefully without these) ──
# AI_MODEL=claude-sonnet-4-20250514    # Override the Claude model
# NEXT_PUBLIC_URL=https://roamly.vercel.app
# OPENWEATHER_API_KEY=                 # Weather data in trip view
# RESEND_API_KEY=                      # Email itinerary feature
# STRIPE_SECRET_KEY=                   # Pro plan billing
# STRIPE_WEBHOOK_SECRET=              # Stripe webhook verification
# STRIPE_PRICE_ID=                     # Stripe price for pro plan

# ── Production hardening (strongly recommended before launch) ─────────
# Persistent rate limiting (falls back to in-memory if unset — NOT safe
# in multi-instance production). Create an Upstash Redis DB:
# https://upstash.com → copy REST URL + token.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Error tracking via Sentry (opt-in). Create a Next.js project at
# https://sentry.io and copy the DSN. Set both for full coverage.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
